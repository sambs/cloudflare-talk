{
  "name": "cloudflare-talk",
  "version": "1.0.0",
  "author": "Sam Barnes",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate --local && pnpm flags:seed --local && cf dev",
    "db:migrate": "node scripts/db-migrate.ts",
    "flags:seed": "node scripts/flags-seed.ts",
    "build": "cf build",
    "deploy": "pnpm db:migrate && cf deploy && pnpm flags:seed",
    "typecheck": "cf workers types && tsc && tsc -p src/client && tsc -p scripts",
    "test": "playwright test",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cf": "^1.0.0-beta.31",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
